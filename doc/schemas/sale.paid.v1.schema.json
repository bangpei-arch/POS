{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pos.example.invalid/schemas/sale.paid.v1.schema.json",
  "title": "POS sale.paid payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sale",
    "lines",
    "payments"
  ],
  "properties": {
    "sale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sale_id",
        "terminal_id",
        "cashier_id",
        "receipt_number",
        "business_date",
        "currency_code",
        "subtotal",
        "discount_total",
        "tax_total",
        "rounding_amount",
        "grand_total",
        "paid_at"
      ],
      "properties": {
        "sale_id": {
          "type": "string",
          "format": "uuid"
        },
        "terminal_id": {
          "type": "string",
          "format": "uuid"
        },
        "cashier_id": {
          "type": "string",
          "format": "uuid"
        },
        "receipt_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "business_date": {
          "type": "string",
          "format": "date"
        },
        "currency_code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "subtotal": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "discount_total": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "tax_total": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "rounding_amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "grand_total": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "paid_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "product_id",
          "sku",
          "name",
          "quantity",
          "unit_price",
          "gross_amount",
          "discount_amount",
          "tax_code",
          "tax_rate",
          "tax_amount",
          "line_total"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "barcode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "gross_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "discount_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "tax_code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 30
          },
          "tax_rate": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
          },
          "tax_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "line_total": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payment_id",
          "method_code",
          "method_name",
          "amount",
          "confirmed_at"
        ],
        "properties": {
          "payment_id": {
            "type": "string",
            "format": "uuid"
          },
          "method_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "method_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
          },
          "reference_number": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
