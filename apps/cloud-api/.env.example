CLOUD_DATABASE_URL=postgresql://pos_cloud:change-me@localhost:5434/pos_cloud
JWT_PRIVATE_KEY_PATH=/run/secrets/cloud-jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/cloud-jwt-public.pem
JWT_KID=cloud-rsa-2026-01
JWT_ISSUER=pos-cloud
JWT_AUDIENCE=pos-cloud-api
TOKEN_TTL_SECONDS=300
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
